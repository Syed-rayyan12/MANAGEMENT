// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────

enum UserRole {
  TL          // Team Lead — oversees PMs within their team
  PM          // Project Manager — manages projects and tasks
  PRODUCTION  // Cross-team execution layer
  EXECUTIVE   // High-level viewer
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── ORGANIZATION ───────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  teams     Team[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

// ─── TEAMS ──────────────────────────────────────────

model Team {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique // URL-friendly: "logo-design", "web-design"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  members        TeamMember[]
  workspace      Workspace?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("teams")
}

// ─── TEAM MEMBERS ───────────────────────────────────

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

// ─── WORKSPACES ─────────────────────────────────────

model Workspace {
  id        String            @id @default(uuid())
  name      String
  teamId    String            @unique
  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  columns   WorkspaceColumn[]
  projects  Project[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("workspaces")
}

// ─── WORKSPACE COLUMNS (custom workflow per workspace) ──

model WorkspaceColumn {
  id          String    @id @default(uuid())
  name        String    // Display name: "To Do", "In Progress"
  key         String    // Unique within workspace: "todo", "in-progress"
  color       String    @default("#6B7280")
  position    Int       @default(0)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("workspace_columns")
}

// ─── USERS ──────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      UserRole
  name      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  managedProjects  Project[]       @relation("ProjectManager")
  assignedProjects Project[]       @relation("ProjectDeveloper")
  comments         Comment[]
  activities       ActivityLog[]
  notifications    Notification[]
  teamMembers      TeamMember[]

  @@map("users")
}

// ─── PROJECTS ───────────────────────────────────────

model Project {
  id          String          @id @default(uuid())
  name        String
  status      String          @default("todo") // references WorkspaceColumn.key
  priority    ProjectPriority @default(MEDIUM)
  description String?
  dueDate     DateTime?
  image       String?
  position    Int             @default(0)

  // Workspace relation
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Relations to users
  pmId        String
  pm          User            @relation("ProjectManager", fields: [pmId], references: [id])
  developerId String?
  developer   User?           @relation("ProjectDeveloper", fields: [developerId], references: [id])

  // Child relations
  comments    Comment[]
  checklist   ChecklistItem[]
  labels      ProjectLabel[]
  attachments Attachment[]
  activities  ActivityLog[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("projects")
}

// ─── COMMENTS ───────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  content   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

// ─── CHECKLIST ──────────────────────────────────────

model ChecklistItem {
  id        String  @id @default(uuid())
  title     String
  completed Boolean @default(false)
  position  Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

// ─── LABELS ─────────────────────────────────────────

model Label {
  id       String         @id @default(uuid())
  name     String         @unique
  color    String
  projects ProjectLabel[]

  @@map("labels")
}

model ProjectLabel {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labelId   String
  label     Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([projectId, labelId])
  @@map("project_labels")
}

// ─── ATTACHMENTS ────────────────────────────────────

model Attachment {
  id         String   @id @default(uuid())
  filename   String
  url        String
  key        String?  // R2 object key for deletion
  type       String   // mime type or category: image, pdf, etc.
  size       Int?     // file size in bytes
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())

  @@map("attachments")
}

// ─── ACTIVITY LOG ───────────────────────────────────

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   Json?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

// ─── NOTIFICATIONS ──────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  type      String   // assigned, mention, comment, status, project_created
  message   String
  read      Boolean  @default(false)
  projectId String?
  userId    String   // recipient
  user      User     @relation(fields: [userId], references: [id])
  actorId   String?  // who triggered it
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}
