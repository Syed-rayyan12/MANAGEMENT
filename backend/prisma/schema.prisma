// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────

enum UserRole {
  TL          // Team Lead — oversees PMs within their team
  PM          // Project Manager — manages projects and tasks
  PRODUCTION  // Cross-team execution layer
  EXECUTIVE   // High-level viewer
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}

enum Specialization {
  LOGO_DESIGNER
  FIGMA_DESIGNER
  DEVELOPER
  CONTENT_WRITER
  QA
}

enum AssignmentRole {
  PRIMARY
  COLLABORATOR
}

enum AssignmentStatus {
  ACTIVE
  DONE
}

enum ColumnPhase {
  NOT_STARTED
  IN_PROGRESS
  DONE
  ON_HOLD
}

// ─── ORGANIZATION ───────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  teams     Team[]
  boards    Board[]
  clients   Client[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

// ─── CLIENTS ────────────────────────────────────────

model Client {
  id             String       @id @default(uuid())
  name           String
  contactEmail   String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projects       Project[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("clients")
}

// ─── TEAMS (sales teams — for project ownership / visibility) ──

model Team {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  members        TeamMember[]
  projects       Project[]
  invoices       Invoice[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("teams")
}

// ─── TEAM MEMBERS ───────────────────────────────────

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

// ─── BOARDS (org-level, shared by all teams) ────────

model Board {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  columns        BoardColumn[]
  projects       Project[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?     @map("deleted_at")
  deletedById    String?       @map("deleted_by_id")
  deletedBy      User?         @relation("deletedBoards", fields: [deletedById], references: [id], onDelete: SetNull)

  @@map("boards")
}

// ─── BOARD COLUMNS (workflow stages per board) ──────

model BoardColumn {
  id          String      @id @default(uuid())
  name        String
  key         String
  color       String      @default("#6B7280")
  position    Int         @default(0)
  phase       ColumnPhase @default(NOT_STARTED)
  boardId     String
  board       Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?   @map("deleted_at")
  deletedById String?     @map("deleted_by_id")
  deletedBy   User?       @relation("deletedColumns", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([boardId, key])
  @@map("board_columns")
}

// ─── USERS ──────────────────────────────────────────

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  email          String          @unique
  password       String
  role           UserRole
  name           String
  avatar         String?
  specialization Specialization?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  assignments      ProjectAssignment[]
  comments         Comment[]
  activities       ActivityLog[]
  notifications    Notification[]
  teamMembers      TeamMember[]
  invoices         Invoice[]
  deletedBoards    Board[]             @relation("deletedBoards")
  deletedColumns   BoardColumn[]       @relation("deletedColumns")
  deletedProjects  Project[]           @relation("deletedProjects")
  regressionsReceived Regression[]     @relation("regressionTarget")
  regressionsCaused   Regression[]     @relation("regressionCauser")
  attendanceRecords   Attendance[]
  attendanceEdits     Attendance[]     @relation("attendanceEdits")

  @@map("users")
}

// ─── PROJECTS ───────────────────────────────────────

model Project {
  id          String          @id @default(uuid())
  name        String
  status      String          @default("todo") // references BoardColumn.key
  priority    ProjectPriority @default(MEDIUM)
  description String?
  dueDate     DateTime?
  image       String?
  position    Int             @default(0)
  trelloCardId String?        @unique // Trello card ID for duplicate detection

  // Board relation (which service board: logo, web design, etc.)
  boardId     String
  board       Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)

  // Team relation (which sales team owns this project)
  teamId      String
  team        Team            @relation(fields: [teamId], references: [id])

  // Relations to users
  assignments ProjectAssignment[]

  // Client relation (optional — for cross-board linking)
  clientId    String?
  client      Client?         @relation(fields: [clientId], references: [id])

  // Child relations
  comments    Comment[]
  checklist   ChecklistItem[]
  labels      ProjectLabel[]
  attachments Attachment[]
  activities  ActivityLog[]
  regressions Regression[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?       @map("deleted_at")
  deletedById String?         @map("deleted_by_id")
  deletedBy   User?           @relation("deletedProjects", fields: [deletedById], references: [id], onDelete: SetNull)

  @@map("projects")
}

// ─── PROJECT ASSIGNMENTS ────────────────────────────

model ProjectAssignment {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        AssignmentRole   @default(PRIMARY)
  status      AssignmentStatus @default(ACTIVE)
  assignedAt  DateTime         @default(now())
  completedAt DateTime?

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_assignments")
}

// ─── REGRESSIONS (backward column moves) ─────────

model Regression {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String   // production user whose work was regressed
  user       User     @relation("regressionTarget", fields: [userId], references: [id], onDelete: Cascade)
  causedById String   // who moved it backward
  causedBy   User     @relation("regressionCauser", fields: [causedById], references: [id], onDelete: Cascade)
  fromColumn String   // column key it was in before
  toColumn   String   // column key it moved back to
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@map("regressions")
}

// ─── COMMENTS ───────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  content   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

// ─── CHECKLIST ──────────────────────────────────────

model ChecklistItem {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  position  Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy String?
  createdAt DateTime @default(now())

  @@map("checklist_items")
}

// ─── LABELS ─────────────────────────────────────────

model Label {
  id       String         @id @default(uuid())
  name     String         @unique
  color    String
  projects ProjectLabel[]

  @@map("labels")
}

model ProjectLabel {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labelId   String
  label     Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([projectId, labelId])
  @@map("project_labels")
}

// ─── ATTACHMENTS ────────────────────────────────────

model Attachment {
  id         String   @id @default(uuid())
  filename   String
  url        String
  key        String?  // R2 object key for deletion
  type       String   // mime type or category: image, pdf, etc.
  size       Int?     // file size in bytes
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())

  @@map("attachments")
}

// ─── ACTIVITY LOG ───────────────────────────────────

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   Json?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

// ─── NOTIFICATIONS ──────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  type      String   // assigned, mention, comment, status, project_created
  message   String
  read      Boolean  @default(false)
  projectId String?
  userId    String   // recipient
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?  // who triggered it
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ─── INVOICES ─────────────────────────────────────

model Invoice {
  id              String        @id @default(uuid())
  clientName      String
  clientEmail     String?
  description     String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("GBP")
  status              InvoiceStatus @default(PENDING)
  squarePaymentLinkId String?       @unique // Square payment link ID
  squareOrderId       String?       // Square order ID (for webhook matching)
  paymentLink         String?       // Square checkout URL
  paidAt              DateTime?

  // Who created this invoice
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Team association (for visibility scoping)
  teamId          String
  team            Team          @relation(fields: [teamId], references: [id])

  // Webhook idempotency
  lastWebhookEventId String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([createdById])
  @@index([teamId])
  @@index([status])
  @@map("invoices")
}

// ─── ATTENDANCE ──────────────────────────────────

model Attendance {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  checkIn     DateTime
  checkOut    DateTime?
  hoursWorked Decimal?  @db.Decimal(5, 2)
  isWeekend   Boolean   @default(false)
  editedById  String?
  editedBy    User?     @relation("attendanceEdits", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendance")
}
